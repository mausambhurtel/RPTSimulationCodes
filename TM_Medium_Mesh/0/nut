FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    INFLOW
    {
        type            calculated;
        value           $internalField;
    }
    OUTFLOW
    {
        type            calculated;
        value           $internalField;
    }
	BLADE
    {
        type            nutkWallFunction;
        value           $internalField;
    }
    HUB
    {
        type            nutkWallFunction;
        value           $internalField;
    }
    SHROUD
    {
        type            nutkWallFunction;
        value           $internalField;
    }
    PER1
    {
        type            cyclic;
    }
    PER2
    {
        type            cyclic;
     }
}


