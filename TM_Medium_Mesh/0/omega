FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 6.7;

boundaryField
{
    INFLOW
    {
        type            fixedValue;
        value           $internalField;   
    }
    OUTFLOW
    {
        type            inletOutlet;
        inletValue      $internalField;   
    }
    BLADE
    {
        type            omegaWallFunction;
	blended		true;
        value           $internalField;   
    }
    HUB
    {
        type            omegaWallFunction;
	blended		true;
        value           $internalField;   
    }
    SHROUD
    {
        type            omegaWallFunction;
	blended		true;
        value           $internalField;   
    }
    PER1
    {
        type            cyclic;

    }
    PER2
    {
        type            cyclic;

    }
}


