FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Urel;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 11.9);

boundaryField
{
    INFLOW
    {
	type            SRFVelocity;
        inletValue      uniform (0 0 11.9);
        relative        no;
        value           uniform (0 0 0);
   }

    OUTFLOW
    {
	type            pressureInletOutletVelocity;
        value           $internalField;
    }

    BLADE
    {
        type            movingWallVelocity;	
		value			uniform (0 0 0);
    }

    HUB
    {
        type            movingWallVelocity;	
		value			uniform (0 0 0);
    }

    SHROUD
    {
        type            movingWallVelocity;	
		value			uniform (0 0 0);
    }

    PER1
    {
        type            cyclic;
    }

    PER2
    {
        type            cyclic;
    }
}


